SUPABASE_URL=
# Public key (safe for browsers) - used ONLY to check logins
SUPABASE_PUBLISHABLE_KEY=
# Secret key (Dashboard > Project Settings > API > service_role / secret). Server only - never share it.
SUPABASE_SERVICE_KEY=
FLASK_SECRET_KEY=

# ---- The ONE fixed manager account (created automatically on first start) ----
MANAGER_EMAIL=
MANAGER_PASSWORD=
MANAGER_NAME=

# ---- Email (needed to send tenant login details + manager password reset) ----
# Gmail example: turn on 2-step verification, then create an "App password" and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_FROM_NAME=Property Management
# Public address of the site (used in the emails). Locally: http://127.0.0.1:5000
SITE_URL=http://127.0.0.1:5000
